{
  "version": 2,
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|favicon.svg|apple-touch-icon.png|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
